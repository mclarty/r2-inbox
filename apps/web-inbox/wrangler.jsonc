// Template config. `scripts/deploy.sh` renders a real config from r2-inbox.config.json into
// .wrangler.generated.jsonc (gitignored). Values here are placeholders for local `wrangler dev`.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "r2-inbox-web",
  "main": "src/index.js",
  "compatibility_date": "2026-10-13",
  // Keep workers.dev off in production: only the Access-protected custom domain should serve.
  "workers_dev": false,
  "vars": {
    "BUCKET_NAME": "my-mail-bucket",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // Outbound mail stays off until these are set for real and EMAIL_API_TOKEN
    // is installed with `wrangler secret put`. See docs/outbound.md.
    // EMAIL_ACCOUNT_ID comes from $CLOUDFLARE_ACCOUNT_ID at deploy time.
    "MAIL_FROM": "",
    "MAIL_FROM_NAME": "",
    "MAIL_REPLY_TO": "",
    "MAIL_OWN_ADDRESSES": "",
    "EMAIL_ZONE_ID": "",
    // Copied dashboard activity-log prefix. Empty disables Open in Cloudflare.
    "EMAIL_ACTIVITY_LOG_BASE": ""
  },
  "r2_buckets": [
    { "binding": "MAIL", "bucket_name": "my-mail-bucket" }
  ]
  // "routes": [{ "pattern": "inbox.example.com", "custom_domain": true }]
}
